  "goals": {
    "conversion": {
      "action": "tornar valor e próximo passo inequívocos",
      "metric": "ação qualificada concluída",
      "guardrail": "sem urgência ou prova social inventada"
    },
    "retention": {
      "action": "criar motivos verdadeiros para voltar",
      "metric": "retorno voluntário com valor",
      "guardrail": "sem loops coercitivos ou notificações manipulativas"
    },
    "activation": {
      "action": "entregar primeira experiência útil rapidamente",
      "metric": "primeira tarefa significativa concluída",
      "guardrail": "sem onboarding que esconda limitações"
    },
    "trust": {
      "action": "mostrar transparência e controle verificáveis",
      "metric": "compreensão de riscos e termos",
      "guardrail": "sem ícones de segurança usados como prova"
    },
    "accuracy": {
      "action": "prevenir erro e manter rastreabilidade",
      "metric": "porcentagem de tarefas corretas",
      "guardrail": "não ocultar campos ou chaves"
    },
    "efficiency": {
      "action": "reduzir passos e tempo sem perda de informação",
      "metric": "tempo de tarefa correta",
      "guardrail": "não sacrificar precisão por velocidade"
    },
    "learning": {
      "action": "dar feedback e progressão orientados à aprendizagem",
      "metric": "evidência de domínio demonstrado",
      "guardrail": "não inferir aprendizagem de streak"
    },
    "quality_matches": {
      "action": "facilitar bons encontros e triagem transparente",
      "metric": "encontros qualificados e sustentáveis",
      "guardrail": "não maximizar volume irresponsável"
    },
    "task_success": {
      "action": "remover bloqueios da tarefa principal",
      "metric": "conclusão correta da tarefa",
      "guardrail": "preservar recuperação de erros"
    },
    "engagement": {
      "action": "aumentar interação significativa",
      "metric": "interação útil voluntária",
      "guardrail": "sem estímulos manipulativos"
    },
    "artistic_impact": {
      "action": "produzir assombro e identificação por direção artística, composição e comportamento original",
      "metric": "julgamento humano cego de impacto, memorabilidade e originalidade",
      "guardrail": "não substituir espetáculo por widgets ou prometer prêmios"
    },
    "immersion": {
      "action": "fazer tipografia, ambiente, gestos e transições formarem uma única experiência",
      "metric": "revisão cega da continuidade espacial, resposta a gestos e ritmo narrativo",
      "guardrail": "preservar controle, desempenho e alternativas para movimento reduzido"
    },
    "comprehension": {
      "action": "tornar informação correta fácil de encontrar, entender e retomar",
      "metric": "sucesso em tarefas de localização e compreensão, observado com usuários ou tarefas reais",
      "guardrail": "não converter leitura informativa em funil ou atribuir compreensão sem avaliação"
    }
  }
}
